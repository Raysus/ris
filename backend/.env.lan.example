# =====================================================================
# .env para despliegue en LAN (Ubuntu Docker Engine o Windows Docker Desktop)
#
#   Imagen API: PHP 8.5.4 (backend/Dockerfile), alineado con composer.json.
#
#   1. cp .env.lan.example .env
#   2. Reemplace 192.168.1.50 por la IP REAL del servidor en la LAN
#   3. Complete secretos (DB_PASSWORD, CLOUD_SYNC_SECRET, correo, Keycloak)
#   4. docker compose -f docker-compose.lan.yml up -d --build
#
#   NO suba el archivo .env real al repositorio (contiene claves).
# =====================================================================

APP_NAME="HealthTiCloud RIS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# IP del servidor en la LAN (NO localhost: las otras PCs no lo entenderían)
# Sustituya 192.168.1.50 por: hostname -I | awk '{print $1}'
# URL del navegador: IP LAN (http://192.168.x.x) o alias DNS local (ej. siresamatriz.healthticloud.cl)
APP_URL=http://siresamatriz.healthticloud.cl
FRONTEND_URL=http://siresamatriz.healthticloud.cl

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Base de datos (contenedor pgsql) ---
DB_CONNECTION=pgsql
# En .env del servidor: 127.0.0.1 si publica 5432 en docker-compose.lan.yml (php artisan en el host).
# Los contenedores api/queue usan DB_HOST=pgsql vía docker-compose (no cambiar ahí).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ris_db
DB_USERNAME=risuserdb
DB_PASSWORD=cambie-esta-clave

# Sembrar laboratorios/usuarios demo en el PRIMER arranque (luego poner en false)
DB_AUTO_SEED=true

# --- Sesiones / colas / caché ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# IMPORTANTE: en HTTP (LAN sin certificado) debe quedar false.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_TOKEN_EXPIRATION=
# Añada IP Tailscale 100.x.x.x si sistemas prueba el RIS por VPN
SANCTUM_STATEFUL_DOMAINS=siresamatriz.healthticloud.cl,192.168.1.50,localhost,127.0.0.1

# --- Rol en laboratorio (stack LAN) ---
RIS_CLOUD_ROLE=local
CLOUD_API_BASE=https://api.healthticloud.cl/api
CLOUD_SERVER_URL=https://api.healthticloud.cl/api/sync
# Obligatorio para enviar citas/pacientes a la matriz (mismo valor que en la nube)
CLOUD_SYNC_SECRET=

# --- Correo ---
# log = solo storage/logs. smtp = servidor real del centro (Gmail, relay, etc.)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.ejemplo.cl
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@healthticloud.cl
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SEND_CONFIRMATION=true
MAIL_AUTO_REPORT_READY=false

# --- Portal paciente (servidor externo; enlaces en correos) ---
PATIENT_PORTAL_URL=https://portal.healthticloud.cl

# --- PACS / Orthanc (nube o IP alcanzable desde la LAN del lab) ---
PACS_DEFAULT_IP=172.16.66.11
PACS_DEFAULT_PORT=4242
PACS_DEFAULT_AET=HEALTHTICLOUD
ORTHANC_HOST=172.16.66.11
# IP DICOM alcanzable desde la LAN del centro (Fuji FCR consulta MWL aquí, no por HTTPS).
PACS_DICOM_HOST=170.246.172.84
ORTHANC_PORT=4242
ORTHANC_AET=HEALTHTICLOUD
ORTHANC_URL=https://pacs.healthticloud.cl

# --- MWL local open source (DCMTK wlmscpfs, perfil docker --profile mwl) ---
# Recomendado si el Fuji no ve la worklist en el PACS nube (firewall / FilterIssuerAet).
#MWL_PROVIDER=wlmscpfs
#MWL_DICOM_HOST=192.168.0.131
#MWL_PORT=4242
#MWL_AET=SIRESA_MWL
#MWL_FILES_PATH=/var/www/html/storage/app/mwl-worklists
# Zona horaria del centro para agenda y hora en worklist (.wl). Sin esto, la hora DICOM puede salir en UTC (ej. 21:00 en vez de 17:00).
#WORKLIST_TIMEZONE=America/Santiago
#APP_LAB_TIMEZONE=America/Santiago
# Alternativa Orthanc local (requiere plugin worklists con REST):
#MWL_PROVIDER=orthanc
#MWL_ORTHANC_URL=http://mwl:8042

# --- Visor EN LA NUBE (OHIF) ---
VIEWER_TYPE=ohif
VIEWER_URL=https://viewer.healthticloud.cl
VIEWER_PATH=/viewer
VIEWER_QUERY_PARAM=StudyInstanceUIDs
VIEWER_ACCESSION_PARAM=StudyInstanceUIDs
VIEWER_TOKEN=
PACS_BRIDGE_URL=http://localhost:8181/open-dicom
VIEWER_CUSTOM_URL=

# Alertas dashboard (TAT en minutos)
DASHBOARD_TAT_ALERT_MINUTES=180

# --- Integraciones opcionales ---
FONASA_ENABLED=false
FONASA_API_URL=
FONASA_API_TOKEN=
FONASA_SIMULATE=true
FONASA_DEFAULT_BONIFICACION_PCT=80

DTE_ENABLED=false
DTE_PROVIDER_URL=
DTE_PROVIDER_TOKEN=
DTE_EMISOR_RUT=
DTE_EMISOR_RAZON_SOCIAL=HealthTiCloud RIS
DTE_SIMULATE=true

FHIR_ENABLED=false
FHIR_INBOUND_SECRET=

HL7_ENABLED=false
HL7_INBOUND_SECRET=
HL7_OUTBOUND_URL=
HL7_OUTBOUND_SECRET=
HL7_SEND_ORU_ON_SIGN=false
HL7_SENDING_APP=HealthTiCloud_RIS
HL7_SENDING_FACILITY=RIS

# Keycloak (usuarios portal / verificación correo; opcional en LAN)
KEYCLOAK_BASE_URL=https://sso.healthticloud.cl
KEYCLOAK_REALM=patient-portal
KEYCLOAK_TARGET_REALM=patient-portal
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_ID=patient-portal
KEYCLOAK_SEND_VERIFY_EMAIL=true
KEYCLOAK_ACTION_EMAIL_LIFESPAN=43200

# Respaldos (pg_dump dentro del contenedor api)
BACKUP_PATH=/var/www/html/storage/app/backups
PG_DUMP_PATH=pg_dump

VITE_APP_NAME="${APP_NAME}"
