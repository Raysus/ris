APP_NAME="HealthTiCloud RIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# URL del frontend (CORS y enlaces de recuperación de clave)
FRONTEND_URL=http://127.0.0.1:5500

# --- Producción en nube (ejemplo) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.healthticloud.cl
# FRONTEND_URL=https://ris.healthticloud.cl
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# SANCTUM_TOKEN_EXPIRATION=480
# BACKUP_PATH=/var/backups/ris
# PG_DUMP_PATH=/usr/bin/pg_dump

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos (PostgreSQL nativo en servidor o Docker local) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ris_db
DB_USERNAME=risuserdb
DB_PASSWORD=

# Alternativa rápida sin Docker (solo desarrollo):
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Opcional en servidor: instalar Redis nativo y usar QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Tokens Sanctum (minutos). Vacío = no expiran.
SANCTUM_TOKEN_EXPIRATION=
SANCTUM_STATEFUL_DOMAINS=ris.healthticloud.cl,localhost,127.0.0.1

# Correo (log en local; SMTP en producción)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@healthticloud.cl"
MAIL_FROM_NAME="${APP_NAME}"

# Sincronización lab → nube (opcional en instalaciones locales)
CLOUD_SERVER_URL=
CLOUD_SYNC_SECRET=

# Respaldos (php artisan ris:backup)
BACKUP_PATH=
PG_DUMP_PATH=pg_dump

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
