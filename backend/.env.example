APP_NAME="HealthTiCloud RIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# URL del frontend (CORS y enlaces de recuperación de clave)
FRONTEND_URL=http://127.0.0.1:5500

# --- Producción en nube (ejemplo) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.healthticloud.cl
# FRONTEND_URL=https://ris.healthticloud.cl
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# SANCTUM_TOKEN_EXPIRATION=480
# BACKUP_PATH=/var/backups/ris
# PG_DUMP_PATH=/usr/bin/pg_dump

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos (PostgreSQL nativo en servidor o Docker local) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ris_db
DB_USERNAME=risuserdb
DB_PASSWORD=

# Alternativa rápida sin Docker (solo desarrollo):
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Opcional en servidor: instalar Redis nativo y usar QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Tokens Sanctum (minutos). Vacío = no expiran.
SANCTUM_TOKEN_EXPIRATION=
SANCTUM_STATEFUL_DOMAINS=ris.healthticloud.cl,localhost,127.0.0.1

# Correo (log en local; SMTP en producción)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@healthticloud.cl"
MAIL_FROM_NAME="${APP_NAME}"

# Sincronización lab → nube (opcional en instalaciones locales)
CLOUD_SERVER_URL=
CLOUD_SYNC_SECRET=

# FONASA / bonos (punto 3)
FONASA_ENABLED=true
FONASA_API_URL=
FONASA_API_TOKEN=
FONASA_SIMULATE=true
FONASA_DEFAULT_BONIFICACION_PCT=80

# DTE — boleta / factura electrónica
DTE_ENABLED=true
DTE_PROVIDER_URL=
DTE_PROVIDER_TOKEN=
DTE_EMISOR_RUT=
DTE_EMISOR_RAZON_SOCIAL=HealthTiCloud RIS
DTE_SIMULATE=true

# FHIR R4
FHIR_ENABLED=true
FHIR_INBOUND_SECRET=

# HL7 / HIS (punto 3)
HL7_ENABLED=false
HL7_INBOUND_SECRET=
HL7_OUTBOUND_URL=
HL7_OUTBOUND_SECRET=
HL7_SEND_ORU_ON_SIGN=false
HL7_SENDING_APP=HealthTiCloud_RIS
HL7_SENDING_FACILITY=RIS

# Respaldos (php artisan ris:backup)
BACKUP_PATH=
PG_DUMP_PATH=pg_dump

# Keycloak (usuarios internos RIS + portal)
KEYCLOAK_BASE_URL=
KEYCLOAK_TARGET_REALM=patient-portal
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_ID=patient-portal
KEYCLOAK_SEND_VERIFY_EMAIL=true
KEYCLOAK_ACTION_EMAIL_LIFESPAN=43200

# Correos al paciente (punto 2)
MAIL_SEND_CONFIRMATION=true
MAIL_AUTO_REPORT_READY=false
# Portal de pacientes (servidor externo; enlaces en correos al paciente)
PATIENT_PORTAL_URL=https://portal.healthticloud.cl

# Visor OHIF (Radiólogo / Validación en el RIS)
VIEWER_TYPE=ohif
VIEWER_URL=https://viewer.healthticloud.cl
VIEWER_PATH=/viewer
VIEWER_QUERY_PARAM=StudyInstanceUIDs
# Compatibilidad (alias de VIEWER_QUERY_PARAM)
VIEWER_ACCESSION_PARAM=StudyInstanceUIDs
VIEWER_TOKEN=
PACS_BRIDGE_URL=http://localhost:8181/open-dicom
# URL custom del visor (fallback tras bridge). Placeholders: {accession} {pacs_ip} {pacs_port} {pacs_aet}
# VIEWER_CUSTOM_URL=osirix://?AccessionNumber={accession}
VIEWER_CUSTOM_URL=
PACS_DEFAULT_IP=172.16.66.11
PACS_DEFAULT_PORT=4242
PACS_DEFAULT_AET=HealthTICloud
ORTHANC_URL=http://127.0.0.1:8042

# Alertas dashboard (TAT en minutos)
DASHBOARD_TAT_ALERT_MINUTES=180

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
